# Copy to .env for a local checkout. systemd EnvironmentFile can use the same
# KEY=value shape. Do not commit the copy.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=infrawatch
PGPASSWORD=infrawatch
PGDATABASE=app

# Optional overrides. See config/infrawatch.conf for the defaults.
# BACKUP_DIR=./var/backups
# RETENTION_DAYS=14
# RETENTION_MIN_KEEP=3
# SYSTEMD_UNITS=postgresql
# ALERT_COMMAND=/usr/local/bin/infrawatch-notify
